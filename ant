<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Ant Colony Optimization | Foraging Field</title>
<style>
:root{--ink:#25332b;--muted:#68766d;--paper:#f4f1e7;--card:#fffdf7;--line:#d9ddce;--green:#426b48;--gold:#c88c35}
*{box-sizing:border-box}
body{margin:0;background:var(--paper);color:var(--ink);font-family:Arial,Helvetica,sans-serif}
main{max-width:1180px;margin:auto;padding:24px 16px 36px}
header{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:18px}
.eyebrow{text-transform:uppercase;letter-spacing:.13em;font-size:.72rem;font-weight:700;color:#6b805c;margin-bottom:8px}
h1{font-family:Georgia,'Times New Roman',serif;font-size:clamp(2rem,4vw,3.1rem);font-weight:500;letter-spacing:-.035em;margin:0 0 7px}
header p{max-width:670px;margin:0;color:var(--muted);line-height:1.5}
.badge{white-space:nowrap;border:1px solid #cbd2bd;border-radius:30px;padding:8px 12px;color:#50674a;background:#fbfaef;font-size:.8rem}
.layout{display:grid;grid-template-columns:minmax(0,1.8fr) minmax(270px,.8fr);gap:16px}
.panel{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:15px;box-shadow:0 5px 20px #39452d08}
.panelhead{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:11px}
h2{font-size:1rem;margin:0}
.small{font-size:.8rem;color:var(--muted)}
canvas{display:block;width:100%;height:auto;border:1px solid #d5d7c5;border-radius:10px;background:#e8e5ce}
#field{aspect-ratio:920/600}
.controls{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0}
button{cursor:pointer;border:1px solid #bdc8b6;border-radius:8px;padding:9px 12px;background:#fffdf7;color:var(--ink);font-weight:700}
button:hover{background:#edf0e4}
button.primary{background:#426b48;color:white;border-color:#426b48}
.settings{display:grid;gap:16px;margin:8px 0 17px}
.controltop{display:flex;justify-content:space-between;gap:8px;font-size:.88rem}
.value{font-weight:700;color:#426b48}
input[type=range]{width:100%;accent-color:#426b48;margin-top:9px}
.metrics{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin:14px 0 18px}
.metric{background:#f6f5eb;border:1px solid #e2e2d2;border-radius:9px;padding:11px}
.metric label{display:block;font-size:.76rem;color:var(--muted)}
.metric strong{display:block;font-size:1.45rem;margin-top:5px;font-weight:700}
h3{font-size:.9rem;margin:16px 0 7px}
.explain{color:var(--muted);font-size:.88rem;line-height:1.55;margin:0}
.steps{list-style:none;padding:0;margin:8px 0 0;display:grid;gap:10px}
.steps li{display:grid;grid-template-columns:27px 1fr;gap:8px;font-size:.86rem;line-height:1.45;color:var(--muted)}
.steps b{display:grid;place-items:center;width:25px;height:25px;border-radius:50%;background:#e6eadc;color:#456343}
.legend{display:flex;gap:12px;flex-wrap:wrap;margin-top:10px;color:var(--muted);font-size:.78rem}
.key{display:inline-block;width:12px;height:12px;border-radius:3px;vertical-align:-2px;margin-right:5px}
.note{padding:11px 12px;background:#f6f0df;border-left:3px solid var(--gold);border-radius:0 8px 8px 0;color:#66563b;font-size:.82rem;line-height:1.5;margin-top:14px}
footer{color:var(--muted);font-size:.8rem;line-height:1.5;margin-top:16px}
@media(max-width:850px){header{display:block}.badge{display:inline-block;margin-top:12px}.layout{grid-template-columns:1fr}}
</style>
</head>
<body>
<main>
<header>
 <div><div class="eyebrow">Nature-inspired algorithms · Field study 01</div>
 <h1>The Foraging Field</h1>
 <p>Watch a colony search through terrain, discover a food source, and gradually reinforce efficient trails. This is Ant Colony Optimization as a little field expedition, not a node-and-line network diagram.</p></div>
 <div class="badge">ACO · live simulation</div>
</header>
<div class="layout">
<section class="panel">
 <div class="panelhead"><h2>Colony territory</h2><span class="small" id="status">Colony exploring</span></div>
 <canvas id="field" width="920" height="600" aria-label="Top-down ant foraging field with terrain, obstacles and pheromone trails"></canvas>
 <div class="legend"><span><i class="key" style="background:#426b48"></i>Nest</span><span><i class="key" style="background:#d89a3e"></i>Food</span><span><i class="key" style="background:#a66b3f"></i>Ants</span><span><i class="key" style="background:#4c8a76"></i>Strong pheromone trail</span><span><i class="key" style="background:#8d9a85"></i>Impassable terrain</span></div>
 <div class="controls"><button class="primary" id="toggle">Ⅱ Pause colony</button><button id="step">Run one round</button><button id="reset">↻ New expedition</button></div>
 <canvas id="chart" width="920" height="170" aria-label="Best path length history"></canvas>
</section>
<aside class="panel">
 <h2>Colony field notes</h2>
 <p class="explain" style="margin-top:8px">Each ant follows local clues rather than knowing the best route in advance. Pheromone left by successful ants changes the odds for the next wave.</p>
 <div class="settings">
  <div><div class="controltop"><label for="ants">Ants per round</label><span class="value" id="antsValue">28</span></div><input id="ants" type="range" min="6" max="70" value="28"></div>
  <div><div class="controltop"><label for="evap">Trail evaporation</label><span class="value" id="evapValue">22%</span></div><input id="evap" type="range" min="5" max="70" value="22"></div>
  <div><div class="controltop"><label for="bias">Trail-following bias</label><span class="value" id="biasValue">1.6×</span></div><input id="bias" type="range" min="0" max="30" value="16"></div>
 </div>
 <div class="metrics">
  <div class="metric"><label>Search round</label><strong id="round">0</strong></div>
  <div class="metric"><label>Shortest route</label><strong id="best">—</strong></div>
  <div class="metric"><label>Successful trips</label><strong id="success">0</strong></div>
  <div class="metric"><label>Average trail strength</label><strong id="trail">0.00</strong></div>
 </div>
 <h3>What to look for</h3>
 <ul class="steps">
  <li><b>1</b><span><strong>Search.</strong> Ants take different routes around ponds, rocks, and brush.</span></li>
  <li><b>2</b><span><strong>Report back.</strong> Successful trips leave pheromone along their path.</span></li>
  <li><b>3</b><span><strong>Forget a little.</strong> Evaporation weakens trails so early detours don't dominate forever.</span></li>
  <li><b>4</b><span><strong>Converge.</strong> Shorter routes tend to get reinforced more and attract more ants.</span></li>
 </ul>
 <div class="note"><strong>Scientific note:</strong> This is an illustrative grid-based ACO model. It shows the search-and-reinforcement principle; its stochastic search does not guarantee the globally shortest path on every run.</div>
</aside>
</div>
<footer>Model outline: ants construct paths on a 2D grid; transition probabilities depend on trail strength and distance to the food source; pheromone evaporates each round; successful routes deposit pheromone inversely proportional to route length.</footer>
</main>
<script>
(()=> {
const W=46,H=30,CW=20,CH=20;
const canvas=document.getElementById('field'),ctx=canvas.getContext('2d'),chart=document.getElementById('chart'),g=chart.getContext('2d');
const $=id=>document.getElementById(id);
const start={x:3,y:15},goal={x:42,y:15};
let blocked=new Set(),pheromone=new Map(),ants=[],bestPath=null,bestLength=Infinity,history=[],round=0,success=0,running=true,last=performance.now(),acc=0,terrain=[];
const key=(x,y)=>y*W+x,xy=k=>({x:k%W,y:Math.floor(k/W)}),edgeKey=(a,b)=>a<b?a+':'+b:b+':'+a;
function buildTerrain(){
 blocked=new Set();terrain=[];
 // Fixed natural barriers leave several winding passages.
 const rocks=[
  [10,0,2,9],[10,12,2,7],[17,5,2,8],[17,17,2,11],
  [25,0,2,7],[25,11,2,8],[33,5,2,9],[33,18,2,8]
 ];
 rocks.forEach(([x,y,w,h])=>{for(let yy=y;yy<Math.min(H,y+h);yy++)for(let xx=x;xx<Math.min(W,x+w);xx++)blocked.add(key(xx,yy))});
 // Add openings to create distinct passages.
 [[10,9],[10,10],[11,10],[17,13],[18,13],[25,7],[26,7],[33,14],[34,14]].forEach(([x,y])=>blocked.delete(key(x,y)));
 // Remove accidental blocking of start/goal approach and ensure a traversable central corridor.
 for(let x=0;x<W;x++){blocked.delete(key(x,15));if(x>4&&x<41&&Math.random()<.10){}}
 // Restore some obstacles in the corridor's surroundings, not the corridor itself.
 for(let y=0;y<H;y++){blocked.delete(key(3,y));blocked.delete(key(42,y))}
 for(let y=0;y<H;y++)for(let x=0;x<W;x++){if(blocked.has(key(x,y)))terrain.push({x,y,type:'rock'})}
}
function dist(a,b){const A=xy(a),B=xy(b);return Math.abs(A.x-B.x)+Math.abs(A.y-B.y)}
function neighbors(k){const p=xy(k),out=[];[[1,0],[-1,0],[0,1],[0,-1]].forEach(([dx,dy])=>{const x=p.x+dx,y=p.y+dy;if(x>=0&&x<W&&y>=0&&y<H&&!blocked.has(key(x,y)))out.push(key(x,y))});return out}
function pher(a,b){return pheromone.get(edgeKey(a,b))||.04}
function chooseNext(cur,visited){
 const opts=neighbors(cur).filter(n=>!visited.has(n));if(!opts.length)return -1;
 const bias=Number($('bias').value)/10;
 const weights=opts.map(n=>Math.pow(pher(cur,n),bias)*Math.pow(1/(1+dist(n,key(goal.x,goal.y))),1.8));
 const sum=weights.reduce((a,b)=>a+b,0);let r=Math.random()*sum;
 for(let i=0;i<opts.length;i++){r-=weights[i];if(r<=0)return opts[i]}return opts[opts.length-1]
}
function makePath(){
 const path=[key(start.x,start.y)],visited=new Set(path);let cur=path[0],max=W*H;
 while(cur!==key(goal.x,goal.y)&&path.length<max){const n=chooseNext(cur,visited);if(n<0)return null;path.push(n);visited.add(n);cur=n}
 return cur===key(goal.x,goal.y)?path:null
}
function iterate(){
 const paths=[];for(let i=0;i<Number($('ants').value);i++){const p=makePath();if(p){paths.push(p);if(p.length<bestLength){bestLength=p.length;bestPath=p.slice()}}}
 const evap=Number($('evap').value)/100;for(const [k,v] of pheromone)pheromone.set(k,Math.max(.025,v*(1-evap)));
 paths.forEach(p=>{const deposit=11/p.length;for(let i=0;i<p.length-1;i++){const k=edgeKey(p[i],p[i+1]);pheromone.set(k,Math.min(5,pheromone.get(k)||.04+deposit))}});
 // The expression above intentionally keeps each route's deposit additive.
 paths.forEach(p=>{const d=11/p.length;for(let i=0;i<p.length-1;i++){const k=edgeKey(p[i],p[i+1]);pheromone.set(k,Math.min(5,(pheromone.get(k)||.04)+d))}});
 round++;success=paths.length;history.push({round,best:bestLength});if(history.length>90)history.shift();
 ants=paths.slice(0,Math.min(65,paths.length)).map(path=>({path,pos:Math.random(),speed:.10+Math.random()*.09}));
 $('status').textContent=bestLength<Infinity?'Routes reinforcing':'Colony exploring';updateStats()
}
function updateStats(){$('round').textContent=round;$('best').textContent=Number.isFinite(bestLength)?bestLength+' steps':'—';$('success').textContent=success;$('trail').textContent=pheromone.size?(Array.from(pheromone.values()).reduce((a,b)=>a+b,0)/pheromone.size).toFixed(2):'0.00'}
function drawTerrain(){
 ctx.clearRect(0,0,canvas.width,canvas.height);
 // paper-like meadow background and scattered grass marks
 ctx.fillStyle='#e9e7d0';ctx.fillRect(0,0,canvas.width,canvas.height);
 for(let i=0;i<240;i++){const x=(i*137.5)%canvas.width,y=(i*83.7)%canvas.height;ctx.strokeStyle=i%3?'#d8ddc1':'#d0d8ba';ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(x,y);ctx.lineTo(x+2,y-3);ctx.stroke()}
 // rocks and brush patches
 blocked.forEach(k=>{const p=xy(k),x=p.x*CW,y=p.y*CH;ctx.fillStyle=(p.x+p.y)%2?'#9da18e':'#a8aa95';ctx.fillRect(x+1,y+1,CW-2,CH-2);ctx.fillStyle='#b9bba8';ctx.beginPath();ctx.ellipse(x+10,y+8,5,3,-.4,0,Math.PI*2);ctx.fill()});
 // pheromone paths: stronger trails are wider and greener
 pheromone.forEach((v,k)=>{const [aa,bb]=k.split(':').map(Number),a=xy(aa),b=xy(bb);ctx.beginPath();ctx.moveTo(a.x*CW+CW/2,a.y*CH+CH/2);ctx.lineTo(b.x*CW+CW/2,b.y*CH+CH/2);ctx.lineCap='round';ctx.strokeStyle=`rgba(47,128,108,${Math.min(.58,.10+v*.13)})`;ctx.lineWidth=Math.min(8,1+v*1.5);ctx.stroke()});
 // best route highlighted separately
 if(bestPath){ctx.beginPath();bestPath.forEach((k,i)=>{const p=xy(k),x=p.x*CW+CW/2,y=p.y*CH+CH/2;if(i===0)ctx.moveTo(x,y);else ctx.lineTo(x,y)});ctx.strokeStyle='#3d6f9a';ctx.lineWidth=2.3;ctx.setLineDash([5,4]);ctx.stroke();ctx.setLineDash([])}
 // moving ants
 ants.forEach(a=>{if(a.path.length<2)return;const f=(a.pos%1)*(a.path.length-1),i=Math.min(a.path.length-2,Math.floor(f)),t=f-i,p=xy(a.path[i]),q=xy(a.path[i+1]),x=(p.x+(q.x-p.x)*t)*CW+CW/2,y=(p.y+(q.y-p.y)*t)*CH+CH/2,ang=Math.atan2(q.y-p.y,q.x-p.x);ctx.save();ctx.translate(x,y);ctx.rotate(ang);ctx.fillStyle='#8e4e2c';ctx.beginPath();ctx.ellipse(0,0,5,2.5,0,0,Math.PI*2);ctx.fill();ctx.beginPath();ctx.arc(5,0,2.1,0,Math.PI*2);ctx.fill();ctx.restore()});
 // nest badge
 const sx=start.x*CW+CW/2,sy=start.y*CH+CH/2;ctx.fillStyle='#3f6d46';ctx.beginPath();ctx.arc(sx,sy,14,0,Math.PI*2);ctx.fill();ctx.fillStyle='#fff';ctx.font='bold 11px Arial';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText('N',sx,sy);ctx.fillStyle='#334a35';ctx.font='bold 12px Arial';ctx.fillText('NEST',sx,sy-24);
 // food patch
 const gx=goal.x*CW+CW/2,gy=goal.y*CH+CH/2;ctx.fillStyle='#d79a3e';ctx.beginPath();ctx.arc(gx,gy,14,0,Math.PI*2);ctx.fill();ctx.fillStyle='#fff';ctx.font='bold 11px Arial';ctx.fillText('F',gx,gy);ctx.fillStyle='#694a1f';ctx.font='bold 12px Arial';ctx.fillText('FOOD',gx,gy-24);
 // edge margin labels
 ctx.textAlign='left';ctx.textBaseline='alphabetic';ctx.fillStyle='#6d7965';ctx.font='11px Arial';ctx.fillText('MEADOW · ROCKS · BRUSH',12,16)
}
function drawChart(){const w=chart.width,h=chart.height;g.clearRect(0,0,w,h);g.fillStyle='#fbfaf2';g.fillRect(0,0,w,h);g.fillStyle='#68766d';g.font='12px Arial';g.fillText('Shortest route discovered · fewer steps is better',12,18);g.strokeStyle='#e1e4d7';for(let i=1;i<4;i++){g.beginPath();g.moveTo(0,i*h/4);g.lineTo(w,i*h/4);g.stroke()}if(history.length>1){const vals=history.map(x=>x.best),min=Math.min(...vals)-4,max=Math.max(...vals)+4,range=Math.max(1,max-min);g.beginPath();history.forEach((p,i)=>{const x=12+i/(history.length-1)*(w-24),y=h-15-(p.best-min)/range*(h-43);if(i===0)g.moveTo(x,y);else g.lineTo(x,y)});g.strokeStyle='#426b48';g.lineWidth=2.5;g.stroke()}}
function frame(now){const dt=Math.min(.05,(now-last)/1000);last=now;if(running){acc+=dt;if(acc>.7){iterate();acc=0}ants.forEach(a=>a.pos=(a.pos+dt*a.speed)%1)}drawTerrain();drawChart();requestAnimationFrame(frame)}
$('ants').addEventListener('input',()=>$('antsValue').textContent=$('ants').value);$('evap').addEventListener('input',()=>$('evapValue').textContent=$('evap').value+'%');$('bias').addEventListener('input',()=>$('biasValue').textContent=(Number($('bias').value)/10).toFixed(1)+'×');
$('toggle').addEventListener('click',()=>{running=!running;$('toggle').textContent=running?'Ⅱ Pause colony':'▶ Resume colony';last=performance.now()});
$('step').addEventListener('click',()=>{iterate();drawTerrain();drawChart()});
$('reset').addEventListener('click',()=>{pheromone=new Map();ants=[];bestPath=null;bestLength=Infinity;history=[];round=0;success=0;acc=0;buildTerrain();updateStats()});
buildTerrain();updateStats();requestAnimationFrame(frame);
})();
</script></body></html>
